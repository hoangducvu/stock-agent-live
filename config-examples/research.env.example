# Copy to ~/.config/nexlara/research.env (chmod 600). Never commit real keys.
# The deploy script attaches the file to the API container when it exists.
TRADING_MODE=paper
AI_ENABLED=false
# Managed deployment uses Settings → Optional AI research API for the key and opt-in.
# Environment AI_ENABLED/API keys do not override an empty saved user key.
PREMARKET_AI_ENABLED=true
POSTMARKET_AI_ENABLED=true
AI_PROTOTYPE_MODE=true
# Compare the entire technical pool once before choosing detailed research slots.
AI_BATCH_REVIEW_ENABLED=true
# Prototype uses daily watchlist + deterministic entry checks; no per-signal AI.
AI_TRADE_VALIDATION_ENABLED=false
AI_PROVIDER=anthropic
AI_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_API_KEY=   # Standalone adapter only; managed worker uses encrypted settings.
AI_PREMARKET_TIME=08:30
AI_POSTMARKET_TIME=16:15
ENTRY_EVALUATION_START=10:00
MARKET_TIMEZONE=America/New_York
AI_OPENING_RESTRICTION_MINUTES=30
TARGET_MIN_HOLD_DAYS=10
TARGET_MAX_HOLD_DAYS=90
MAX_AI_CALLS_PER_DAY=8
MAX_AI_COST_USD_PER_DAY=0.20
MAX_AI_TOKENS_PER_REQUEST=12000
MAX_AI_CANDIDATES_PER_REQUEST=3
AI_SIGNAL_COOLDOWN_MINUTES=30
AI_TIMEOUT_SECONDS=25
# Operator-supplied prices must match the selected model. No automatic model switch.
AI_INPUT_USD_PER_MILLION=1.00
AI_OUTPUT_USD_PER_MILLION=5.00
AI_MIN_PRICE=5
AI_MIN_DOLLAR_VOLUME=20000000
# All active, tradable US equities returned by Alpaca are screened before AI.
# Historical AI_UNIVERSE_LIMIT / AI_UNIVERSE_SYMBOLS settings are ignored.
AI_REQUIRE_FUNDAMENTALS=true
AI_REQUIRE_EARNINGS=true
# Optional verified evidence adapter; prototype obtains evidence through bounded web research.
AI_EVIDENCE_FILE=
AI_MAX_PORTFOLIO_EXPOSURE=0.60
AI_MAX_SECTOR_EXPOSURE=0.30
AI_MAX_SPREAD_BPS=30
AI_MAX_SLIPPAGE_BPS=30
AI_MAX_ATR_PCT=0.08
AI_ALLOW_ADDITIONAL_CANDIDATES=false
AI_EARNINGS_BUFFER_DAYS=3
AI_RSI_MIN=35
AI_RSI_MAX=75
AI_MIN_RELATIVE_STRENGTH=0
