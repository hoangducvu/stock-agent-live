FROM docker.io/library/python:3.12-slim
WORKDIR /app
COPY src/requirements.txt src/constraints.txt ./
COPY src/backend/requirements.txt ./backend-requirements.txt
RUN python -m pip install --no-cache-dir -c constraints.txt -r requirements.txt -r backend-requirements.txt && python -m pip check
COPY src/ ./
RUN mkdir -p /app/data /app/logs
ENV NEXLARA_WORKER_ENABLED=true PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 BOT_SCRIPT=/app/main.py
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
